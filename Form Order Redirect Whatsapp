<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Form Data Customer</title>

<style>
.customer-form-wrapper *{
  box-sizing:border-box;
}

.customer-form-wrapper{
  margin:0;
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial;
  background:#ffffff;
}

.customer-form-wrapper .form-card{
  padding:16px;
  max-width:480px;
  margin:auto;
}

.customer-form-wrapper h2{
  margin:0 0 4px;
  font-size:1.4rem;
}

.customer-form-wrapper p{
  margin:0 0 20px;
  color:#6b7280;
  font-size:.9rem;
}

.customer-form-wrapper .field{
  position:relative;
  margin-bottom:14px;
}

.customer-form-wrapper .field input{
  width:100%;
  padding:14px;
  border-radius:8px;
  border:1px solid #e5e7eb;
  font-size:1rem;
  outline:none;
}

.customer-form-wrapper .field label{
  position:absolute;
  left:14px;
  top:50%;
  transform:translateY(-50%);
  background:#fff;
  padding:0 6px;
  color:#9ca3af;
  font-size:.85rem;
  pointer-events:none;
  transition:.2s;
}

.customer-form-wrapper .field input:focus + label,
.customer-form-wrapper .field input:not(:placeholder-shown) + label{
  top:-8px;
  font-size:.7rem;
  color:#111827;
}

.customer-form-wrapper button{
  width:100%;
  padding:15px;
  border:none;
  border-radius:8px;
  background:#25D366;
  color:#fff;
  font-weight:600;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  transition:background 0.3s ease;
}

.customer-form-wrapper button:hover{
  background:#20BA5A;
}

.customer-form-wrapper button.loading{
  opacity:.8;
  pointer-events:none;
}

.customer-form-wrapper .wa-icon{
  width:22px;
  height:22px;
  display:inline-block;
}
</style>
</head>

<body>

<div class="customer-form-wrapper">
  <div class="form-card">
    <h2>Form Order</h2>
    <p>Lengkapi data berikut</p>

    <form id="leadForm">
      <div class="field">
        <input type="text" name="nama" required placeholder=" ">
        <label>Nama Lengkap</label>
      </div>

      <div class="field">
        <input type="email" name="email" required placeholder=" ">
        <label>Email</label>
      </div>

      <div class="field">
        <input
          id="wa"
          type="tel"
          name="whatsapp"
          required
          inputmode="numeric"
          value="08"
          pattern="08[0-9]{8,11}">
        <label>WhatsApp</label>
      </div>

      <button type="submit" id="submitBtn">
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>Order Via WhatsApp</span>
      </button>
    </form>
  </div>
</div>

<script>
function buildWaLink(number){
  let wa = number.replace(/\D/g,'');
  if (wa.startsWith('0')) wa = wa.substring(1);
  if (!wa.startsWith('62')) wa = '62' + wa;
  return `https://wa.me/${wa}`;
}


async function getClientIp() {
  try {
    const res = await fetch('https://api.ipify.org?format=json');
    const data = await res.json();
    return data.ip;
  } catch (error) {
    console.error('Gagal mengambil IP:', error);
    return null;
  }
}

function getFbp() {
  const match = document.cookie.match(/_fbp=([^;]+)/);
  return match ? match[1] : null;
}

const form = document.getElementById('leadForm');
const wa = document.getElementById('wa');
const namaInput = form.querySelector('input[name="nama"]');


wa.value = '08';

wa.addEventListener('keydown', e => {
  const pos = wa.selectionStart;

  if ((e.key === 'Backspace' && pos <= 2) ||
      (e.key === 'Delete' && pos < 2)) {
    e.preventDefault();
  }

  if (!/[0-9]/.test(e.key) &&
      !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
    e.preventDefault();
  }
});

wa.addEventListener('paste', e => {
  e.preventDefault();
  let paste = (e.clipboardData || window.clipboardData).getData('text');
  paste = paste.replace(/\D/g,'');
  if (!paste.startsWith('08')) paste = '08' + paste;
  wa.value = paste;
});

function getFbclid(){
  return new URLSearchParams(window.location.search).get('fbclid');
}

function getFbc(){
  const fbclid = getFbclid();
  if(!fbclid) return null;
  return `fb.1.${Date.now()}.${fbclid}`;
}

form.addEventListener('submit', async (e) => {
  e.preventDefault();

  const btn = document.getElementById('submitBtn');
  const btnSpan = btn.querySelector('span');
  btn.classList.add('loading');
  btnSpan.textContent = 'Mengirim...';

  const waNumber = form.whatsapp.value;
  const waLink = buildWaLink(waNumber);

  // Ambil IP Client
  const clientIp = await getClientIp();
  
  // Ambil Facebook cookies
  const fbp = getFbp();
  const fbc = getFbc();

  // Debug log untuk cek data
  console.log('=== FACEBOOK TRACKING DATA ===');
  console.log('Client IP:', clientIp);
  console.log('FBP Cookie:', fbp);
  console.log('FBC (generated):', fbc);
  console.log('FBCLID (from URL):', getFbclid());
  console.log('==============================');

  const data = new URLSearchParams({
    nama: form.nama.value,
    email: form.email.value,
    whatsapp: waNumber,
    wa_link: waLink,
    fbclid: getFbclid() || '',
    fbc: fbc || '',
    fbp: fbp || '',
    client_user_agent: navigator.userAgent,
    event_source_url: window.location.href,
    client_ip_address: clientIp || ''
  });

  // ISI URL GOOGLE SHEET ANDA
  fetch(
    'GANTI BAGIAN INI',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: data.toString()
    }
  );

  btnSpan.textContent = 'Berhasil ✔';
  
  const nama = namaInput.value.trim();

  setTimeout(() => {
    form.reset();
    wa.value = '08';

    const msg = encodeURIComponent(
      `Halo, saya ${nama}, ingin order produknya dong`
    );

    // GANTI NOMOR ADMIN ANDA (DEPAN NYA HARUS 62)
    window.location.href = `https://wa.me/62811111111?text=${msg}`;
  }, 800);
});

</script>

</body>
</html>



