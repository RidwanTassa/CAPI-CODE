function generateOrderId() {
  const timestamp = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    "yyyyMMddHHmmss"
  );


  const uuidShort = Utilities.getUuid().split("-")[0];


  return `ORD-${timestamp}-${uuidShort}`;
}


function doPost(e) {
  const ss = SpreadsheetApp.openById(
    "GANTI DENGAN ID GOOGLE SHEET ANDA"
  );
  let sheet = ss.getSheetByName("Data Order");
  if (!sheet) sheet = ss.insertSheet("Data Order");


  if (!e) {
    return ContentService.createTextOutput("No Data");
  }


  let p = {};


  if (e.postData && e.postData.contents) {
    try {
      p = JSON.parse(e.postData.contents);
    } catch (err) {
      p = e.parameter || {};
    }
  } else {
    p = e.parameter || {};
  }


  const orderId = generateOrderId();
  const newRow = sheet.getLastRow() + 1;


  sheet.getRange(newRow, 1, 1, 14).setValues([[  
    JSON.stringify(p),
    new Date(),
    orderId,
    p.nama || "",
    p.email || "",
    p.whatsapp || "",
    p.wa_link || "",
    "",  // Kolom H (product)
    "",  // Kolom I (harga_barang)
    "",  // Kolom J (value)
    "",  // Kolom K (quantity)
    "",  // Kolom L (action)
    "",  // Kolom M (status)
    ""   // Kolom N (time)
  ]]);


  return ContentService
    .createTextOutput("OK")
    .setMimeType(ContentService.MimeType.TEXT);
}


function onEditHandler(e) {
 
  if (!e) return;


  const sheet = e.source.getActiveSheet();
  if (sheet.getName() !== 'Data Order') return;


  const range = e.range;
  const row = range.getRow();
  const col = range.getColumn();


  if (row === 1) return;


  const COL_PRODUCT = 8;   // H
  const COL_ACTION = 12;   // L
  const COL_STATUS = 13;   // M
  const COL_TIME = 14;     // N


  if (col === COL_PRODUCT && range.getValue()) {
   
    const actionCell = sheet.getRange(row, COL_ACTION);
   
    const rule = SpreadsheetApp.newDataValidation()
      .requireValueInList(['Leads', 'Purchase'], true)
      .setAllowInvalid(false)
      .build();
   
    actionCell.setDataValidation(rule);
   
    // Set default value jika masih kosong
    if (!actionCell.getValue()) {
      actionCell.setValue('Leads');
    }
   
    return;
  }


  if (col === COL_ACTION && range.getValue() === "Purchase") {


    const lock = LockService.getScriptLock();
    lock.waitLock(3000);


    try {


      const statusCell = sheet.getRange(row, COL_STATUS);


      // Cegah double kirim jika sudah ada status
      const currentStatus = statusCell.getValue();
      if (currentStatus && currentStatus.toString().trim() !== "") {
        return;
      }


      const result = sendToWebhook(row, sheet);


      // 🔹 Parse JSON response dan ambil message
      let displayMessage = result.body;
     
      try {
        const jsonResponse = JSON.parse(result.body);
        displayMessage = jsonResponse.message || result.body;
      } catch (parseError) {
        displayMessage = result.body;
      }


      sheet.getRange(row, COL_STATUS).setValue(displayMessage);
const timeCell = sheet.getRange(row, COL_TIME);
timeCell.setValue(new Date());
timeCell.setNumberFormat('HH:mm:ss');


    } catch (err) {


      sheet.getRange(row, COL_STATUS)
           .setValue("ERROR: " + err.message);


    } finally {


      lock.releaseLock();


    }
  }
}


function sendToWebhook(row, sheet) {


